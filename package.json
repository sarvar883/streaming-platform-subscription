{
    "name": "setanta-subscription-service",
    "version": "1.0.0",
    "description": "",
    "author": "Sarvar Sharapov",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node build/main",
        "build:example": "nest build -c nest-cli.example.json",
        "prepare": "node -e \"if(require('fs').existsSync('.git')){process.exit(1)}\" || git config core.hooksPath .githooks",
        "start:example": "nest start -c nest-cli.example.json",
        "start:dev:example": "nest start -c nest-cli.example.json --watch",
        "start:debug:example": "nest start -c nest-cli.example.json --watch",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "lint-staged": "lint-staged"
    },
    "dependencies": {
        "@nestjs/common": "^9.0.0",
        "@nestjs/core": "^9.0.0",
        "@nestjs/platform-express": "^9.0.0",
        "@payme/common": "^1.0.9",
        "@payme/config-container": "1.3.4",
        "@payme/console-logger": "^1.1.3",
        "@payme/http-client": "^3.2.1",
        "@payme/json-rpc": "^2.2.13",
        "@payme/json-rpc-http-transport": "^2.2.14",
        "@payme/logger": "^2.1.3",
        "@payme/nest-json-rpc": "^1.4.3",
        "@payme/nestjs-common": "^1.3.3",
        "@payme/nestjs-communication-utils": "^1.0.6",
        "appdynamics": "^23.10.0",
        "class-validator": "^0.14.0",
        "kafkajs": "^2.2.4",
        "mongoose": "^8.7.0",
        "pino": "^9.3.2",
        "tinypool": "^1.0.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^9.0.0",
        "@nestjs/schematics": "^9.0.0",
        "@nestjs/testing": "^9.0.0",
        "@payme/eslint-config-backend": "^1.0.5",
        "@swc/core": "1.4.8",
        "@swc/jest": "0.2.36",
        "@types/convict": "^6.1.2",
        "@types/jest": "29.5.0",
        "@types/node": "18.15.11",
        "@types/supertest": "^2.0.11",
        "eslint": "^8.38.0",
        "jest": "29.5.0",
        "lint-staged": "^14.0.1",
        "prettier": "^2.3.2",
        "source-map-support": "^0.5.20",
        "supertest": "^6.1.3",
        "ts-jest": "29.0.5",
        "ts-loader": "^9.2.3",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "4.2.0",
        "typescript": "^5.5.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "@swc/jest"
        },
        "collectCoverageFrom": [
            "src/**/*.(t|j)s",
            "!**/node_modules/**",
            "!**/coverage/**",
            "!**/build/**",
            "!**/**/index.ts",
            "!src/**/repository.ts",
            "!src/app/services/api/**",
            "!src/infrastructure/logger/**",
            "!src/infrastructure/dependency-injection/**",
            "!src/infrastructure/config/**",
            "!src/infrastructure/data/impl/mongo/**",
            "!src/infrastructure/appdynamics/**",
            "!src/infrastructure/als/**",
            "!src/domain/_core/**",
            "!src/domain/utils/**",
            "!src/domain/errors/**"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@domain/(.*)$": "<rootDir>/src/domain/$1",
            "^@services/(.*)$": "<rootDir>/src/app/services/$1",
            "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
            "^@data/(.*)$": "<rootDir>/src/infrastructure/data/$1",
            "^@usecases/(.*)$": "<rootDir>/src/app/usecases/$1",
            "^@di/(.*)$": "<rootDir>/src/infrastructure/dependency-injection/$1",
            "^test/(.*)$": "<rootDir>/test/$1"
        }
    }
}
