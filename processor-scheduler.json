{
    "name": "setanta-subscription-processor",
    "script": "./build/app/services/processor/main.js",
    "max_memory_restart": "1500M",
    "log_date_format": "YYYY-MM-DD HH:mm Z",
    "log_file": "/server/.logs/setanta-subscription-processor.log",
    "out_file": "/server/.logs/setanta-subscription-processor_out.log",
    "error_file": "/server/.logs/setanta-subscription-processor_error.log",
    "combine_logs": true,
    "pid_file": "/server/.logs/setanta-subscription-processor.pid",
    "interpreter": "node@22.23.4",
    "autorestart": true,
    "env": {
        "NODE_ENV": "production"
    }
}